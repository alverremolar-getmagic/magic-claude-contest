{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "components/typography/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:League Spartan|Hind|Baloo 2))/i]",
        "message": "Font not provided by the design system. Available: League Spartan, Hind, Baloo 2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aurora'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|still|as|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Aurora> doesn't accept that prop. Declared props: variant, still, as, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aurora'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:top|soft)$/]",
        "message": "<Aurora> variant must be one of 'top' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:solid|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: solid, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|href|children|disabled|loading|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, as, href, children, disabled, loading, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|light)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|interactive|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: size, interactive, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|large|pillow)$/]",
        "message": "<Card> size must be one of 'default' | 'large' | 'pillow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABar'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|headline|gradientWord|body|ctaLabel|ctaHref|aurora|key|ref|className|style|children)$/]",
        "message": "<CTABar> doesn't accept that prop. Declared props: kicker, headline, gradientWord, body, ctaLabel, ctaHref, aurora."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|type|hint|error|placeholder|defaultValue|disabled|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, id, type, hint, error, placeholder, defaultValue, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|key|ref|className|style|children)$/]",
        "message": "<FlowStep> doesn't accept that prop. Declared props: title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|children|gradientWord|className|style|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: level, children, gradientWord, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|second|style|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: children, second, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|number|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, body, number."
      },
      {
        "selector": "JSXOpeningElement[name.name='LockupMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|key|ref|className|style|children)$/]",
        "message": "<LockupMark> doesn't accept that prop. Declared props: src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|children|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: src, alt, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Split'] > JSXAttribute > JSXIdentifier[name!=/^(?:mediaFirst|children|key|ref|className|style|children)$/]",
        "message": "<Split> doesn't accept that prop. Declared props: mediaFirst, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Teaser'] > JSXAttribute > JSXIdentifier[name!=/^(?:ambient|children|key|ref|className|style|children)$/]",
        "message": "<Teaser> doesn't accept that prop. Declared props: ambient, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Text> doesn't accept that prop. Declared props: variant, as, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:body|meta)$/]",
        "message": "<Text> variant must be one of 'body' | 'meta'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
